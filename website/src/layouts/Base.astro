---
// Page frame shared by all pages: head, TUI-style top bar and bottom bar.
import "../styles/global.css";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import favicon from "../assets/favicon.png";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const repo = "https://github.com/mguentner/sodabox";
const home = import.meta.env.BASE_URL;
// on the landing page tabs scroll in place, elsewhere they link back to it
const onHome = Astro.url.pathname === home;
const tabHref = (id: string) => (onHome ? `#${id}` : `${home}#${id}`);

const tabs = [
  { id: "requirements", label: "Requirements" },
  { id: "why", label: "Why" },
  { id: "threat-model", label: "Threat model" },
  { id: "installation", label: "Installation" },
  { id: "architecture", label: "Architecture" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content="microVMs for agents, analyses and experiments powered by NixOS" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href={favicon.src} />
    <title>{title ? `${title} · sodabox` : "sodabox"}</title>
    <script is:inline>
      // apply a stored theme before first paint (see ThemeSwitcher.astro)
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
      } catch {}
    </script>
  </head>
  <body class="flex min-h-screen flex-col antialiased">
    <!-- top bar, like the TUI header line -->
    <header class="sticky top-0 z-10 border-b border-dim bg-bg">
      <nav class="mx-auto flex w-full max-w-6xl items-center gap-4 px-4 py-1.5 whitespace-nowrap">
        <a href={onHome ? "#top" : home} class="shrink-0 font-bold text-fg no-underline">sodabox</a>
        <ul class="flex min-w-0 gap-1 overflow-x-auto [scrollbar-width:none]">
          {
            tabs.map((t, i) => (
              <li>
                <a
                  href={tabHref(t.id)}
                  data-tab={t.id}
                  class="block px-1.5 text-muted no-underline hover:text-fg data-[active]:bg-yellow-bg data-[active]:text-[#1c1e22]"
                >
                  {i + 1} {t.label}
                </a>
              </li>
            ))
          }
        </ul>
        <span class="ml-auto shrink-0"><ThemeSwitcher /></span>
        <a href={repo} class="shrink-0 text-muted no-underline hover:text-fg">
          [<span class="text-green">github</span>]
        </a>
      </nav>
    </header>

    <div class="flex-1">
      <slot />
    </div>

    <!-- bottom bar, like the TUI status/hint line -->
    <footer class="border-t border-dim">
      <div class="mx-auto flex max-w-6xl flex-wrap gap-x-4 px-4 py-1.5 text-muted">
        <a href={repo} class="text-green no-underline hover:underline">github.com/mguentner/sodabox</a>
        <a href={`${home}imprint/`} class="ml-auto text-muted no-underline hover:text-fg">Imprint</a>
      </div>
    </footer>
  </body>
</html>
