---
// Cycles auto → light → dark. "auto" follows prefers-color-scheme.
// The choice is stored per browser; the head script in index.astro applies it before paint.
// aria-label uses the bare mode names; replace with operator-provided text if wanted.
---

<button
  type="button"
  id="theme-switcher"
  class="cursor-pointer text-muted hover:text-fg"
  aria-label="auto"
  title="auto"
>
  [<span data-glyph class="inline-block w-[1ch] text-center text-yellow">◐</span>]
</button>

<script>
  const modes = ["auto", "light", "dark"] as const;
  type Mode = (typeof modes)[number];
  const glyphs: Record<Mode, string> = { auto: "◐", light: "☀", dark: "☾" };

  const button = document.getElementById("theme-switcher")!;
  const glyph = button.querySelector<HTMLElement>("[data-glyph]")!;

  const read = (): Mode => {
    try {
      const v = localStorage.getItem("theme");
      return v === "light" || v === "dark" ? v : "auto";
    } catch {
      return "auto";
    }
  };

  const apply = (mode: Mode) => {
    const root = document.documentElement;
    if (mode === "auto") root.removeAttribute("data-theme");
    else root.setAttribute("data-theme", mode);
    glyph.textContent = glyphs[mode];
    button.setAttribute("aria-label", mode);
    button.title = mode;
    try {
      if (mode === "auto") localStorage.removeItem("theme");
      else localStorage.setItem("theme", mode);
    } catch {}
  };

  const preset = document.documentElement.dataset.theme;
  let current: Mode = preset === "light" || preset === "dark" ? preset : read();
  apply(current);
  button.addEventListener("click", () => {
    current = modes[(modes.indexOf(current) + 1) % modes.length];
    apply(current);
  });
</script>
